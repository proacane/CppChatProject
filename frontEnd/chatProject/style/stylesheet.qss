/* 设置QListWidgetItem的边框底部分界线 */
ApplyFriendList::item {
    border-bottom: 1px solid #cccccc; /* 灰色分界线 */
    background-color: transparent; /* 默认背景透明 */
}

/* 禁用悬浮效果 */
ApplyFriendList::item:hover {
    background-color: transparent;
}

/* 禁用选中效果 */
ApplyFriendList::item:selected {
    background-color: transparent;
}

ApplyFriendItem {
    background-color: #f1f2f3;
    border-bottom: 2px solid #dbd9d9;
}

